// POWER QUERY - Importar 02_BASE_ITENS_XML.csv preservando identificadores como TEXTO
// Uso: Excel > Dados > Obter Dados > De Outras Fontes > Consulta Nula > Editor Avancado > colar.
// Ajuste somente a linha Pasta (pasta EXEC_... da execucao desejada).
let
    Pasta = "T:\Meu Drive\TRABALHO FARMACIA\BASE ARQUIVOS PARA PESQUISA CONSULTA VINCULO\BASE_XML\PROJETO MESTRE XML - INTELIGENCIA DE COMPRAS\02_BASE_PROCESSADA\BASE_FISCAL\EXEC_AAAAMMDD_HHMMSS\",
    Fonte = Csv.Document(File.Contents(Pasta & "02_BASE_ITENS_XML.csv"), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Cabecalho = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
    // 1) Tudo como texto (EAN, CNPJ, chave, NCM, CEST, CFOP, CST nunca viram numero)
    TudoTexto = Table.TransformColumnTypes(Cabecalho, List.Transform(Table.ColumnNames(Cabecalho), each {_, type text})),
    // 2) Somente as colunas numericas do dicionario (07_DICIONARIO_CAMPOS, TIPO_DADO = NUMERO), cultura pt-BR (virgula decimal)
    Numeros = Table.TransformColumnTypes(TudoTexto, {
        {"QTD_ARQUIVOS_MESMA_CHAVE", type number},
        {"NF_VALOR_TOTAL", type number},
        {"NF_QTD_ITENS", type number},
        {"QTD_COMERCIAL", type number},
        {"VALOR_UNIT_COMERCIAL", type number},
        {"VALOR_PRODUTO", type number},
        {"QTD_TRIBUTAVEL", type number},
